#include <stdlib.h>
#include <string.h>

char* intToRoman(int num) {
    // Arrays representing Roman symbols and their corresponding values
    int values[] = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
    char* symbols[] = {"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};
    
    // Allocate memory for the output string (Max length for 3999 is "MMMCMXCIX" = 9 chars + null terminator)
    char* roman = (char*)malloc(sizeof(char) * 16);
    roman[0] = '\0'; // Initialize as an empty string
    
    // Loop through the values array
    for (int i = 0; i < 13; i++) {
        // While the current value can be subtracted from num
        while (num >= values[i]) {
            strcat(roman, symbols[i]); // Append the Roman symbol
            num -= values[i];          // Reduce num
        }
    }
    
    return roman;
}
