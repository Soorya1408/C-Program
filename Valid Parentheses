#include <stdbool.h>
#include <string.h>
#include <stdlib.h>

bool isValid(char* s) {
    int len = strlen(s);
    
    // Allocate memory for the stack (at most len elements)
    char* stack = (char*)malloc(len * sizeof(char));
    int top = -1;
    
    for (int i = 0; i < len; i++) {
        char current = s[i];
        
        // Push open brackets to the stack
        if (current == '(' || current == '{' || current == '[') {
            stack[++top] = current;
        } 
        // Process closing brackets
        else {
            // If stack is empty, there is no matching open bracket
            if (top == -1) {
                free(stack);
                return false;
            }
            
            char lastOpen = stack[top];
            
            // Check for matching pairs
            if ((current == ')' && lastOpen == '(') ||
                (current == '}' && lastOpen == '{') ||
                (current == ']' && lastOpen == '[')) {
                top--; // Pop the matched bracket
            } else {
                free(stack);
                return false; // Mismatched brackets
            }
        }
    }
    
    // If the stack is empty, all brackets were validly closed
    bool result = (top == -1);
    free(stack);
    return result;
}
