int longestValidParentheses(char* s) {
    int left = 0, right = 0, max_len = 0;
    
    // Find string length manually to avoid string.h dependencies
    int len = 0;
    while (s[len] != '\0') {
        len++;
    }
    
    // Pass 1: Scan from Left to Right
    for (int i = 0; i < len; i++) {
        if (s[i] == '(') {
            left++;
        } else {
            right++;
        }
        
        if (left == right) {
            int current_len = left * 2;
            if (current_len > max_len) {
                max_len = current_len;
            }
        } else if (right > left) {
            left = 0;
            right = 0;
        }
    }
    
    left = 0;
    right = 0;
    
    // Pass 2: Scan from Right to Left
    for (int i = len - 1; i >= 0; i--) {
        if (s[i] == '(') {
            left++;
        } else {
            right++;
        }
        
        if (left == right) {
            int current_len = left * 2;
            if (current_len > max_len) {
                max_len = current_len;
            }
        } else if (left > right) {
            left = 0;
            right = 0;
        }
    }
    
    return max_len;
}
