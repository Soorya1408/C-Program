typedef struct {
    int* data;      // Dynamic array to store queue elements
    int head;       // Index pointing to the front element
    int tail;       // Index pointing to the next available insertion slot
    int size;       // Current number of elements inside the queue
    int capacity;   // Maximum allowed capacity of the queue
} MyCircularQueue;

MyCircularQueue* myCircularQueueCreate(int k) {
    MyCircularQueue* obj = (MyCircularQueue*)malloc(sizeof(MyCircularQueue));
    obj->data = (int*)malloc(k * sizeof(int));
    obj->head = 0;
    obj->tail = 0;
    obj->size = 0;
    obj->capacity = k;
    return obj;
}

bool myCircularQueueIsEmpty(MyCircularQueue* obj) {
    return obj->size == 0;
}

bool myCircularQueueIsFull(MyCircularQueue* obj) {
    return obj->size == obj->capacity;
}

bool myCircularQueueEnQueue(MyCircularQueue* obj, int value) {
    if (myCircularQueueIsFull(obj)) {
        return false;
    }
    obj->data[obj->tail] = value;
    // Advance tail pointer circularly
    obj->tail = (obj->tail + 1) % obj->capacity;
    obj->size++;
    return true;
}

bool myCircularQueueDeQueue(MyCircularQueue* obj) {
    if (myCircularQueueIsEmpty(obj)) {
        return false;
    }
    // Advance head pointer circularly
    obj->head = (obj->head + 1) % obj->capacity;
    obj->size--;
    return true;
}

int myCircularQueueFront(MyCircularQueue* obj) {
    if (myCircularQueueIsEmpty(obj)) {
        return -1;
    }
    return obj->data[obj->head];
}

int myCircularQueueRear(MyCircularQueue* obj) {
    if (myCircularQueueIsEmpty(obj)) {
        return -1;
    }
    // Calculate previous index circularly
    int prevTail = (obj->tail - 1 + obj->capacity) % obj->capacity;
    return obj->data[prevTail];
}

void myCircularQueueFree(MyCircularQueue* obj) {
    if (obj) {
        free(obj->data);
        free(obj);
    }
}
