/**
 * Note: The returned array must be allocated, assume caller calls free().
 */
int* maxSlidingWindow(int* nums, int numsSize, int k, int* returnSize) {
    if (numsSize == 0 || k == 0) {
        *returnSize = 0;
        return NULL;
    }

    int resultCapacity = numsSize - k + 1;
    int* result = (int*)malloc(resultCapacity * sizeof(int));
    *returnSize = resultCapacity;

    // Deque stores the indices of elements
    int* deque = (int*)malloc(numsSize * sizeof(int));
    int head = 0; // Front of the deque
    int tail = 0; // Back of the deque

    int resultIndex = 0;

    for (int i = 0; i < numsSize; i++) {
        // 1. Remove indices that are out of the current window bounds
        if (head < tail && deque[head] < i - k + 1) {
            head++;
        }

        // 2. Remove elements from the back that are smaller than the current element nums[i]
        while (head < tail && nums[deque[tail - 1]] <= nums[i]) {
            tail--;
        }

        // 3. Add the current element's index to the back of the deque
        deque[tail++] = i;

        // 4. The front of the deque is always the maximum for the current window
        if (i >= k - 1) {
            result[resultIndex++] = nums[deque[head]];
        }
    }

    free(deque);
    return result;
}
