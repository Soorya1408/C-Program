#include <stdio.h>
#include <string.h>
#include <limits.h>
#include <stdlib.h>

char* minWindow(char* s, char* t) {
    int s_len = strlen(s);
    int t_len = strlen(t);
    
    if (s_len == 0 || t_len == 0 || s_len < t_len) {
        return "";
    }

    // Frequency maps for characters in t and the current window
    int map_t[128] = {0};
    int map_window[128] = {0};

    // Count unique characters required from t
    int required_unique = 0;
    for (int i = 0; i < t_len; i++) {
        if (map_t[(unsigned char)t[i]] == 0) {
            required_unique++;
        }
        map_t[(unsigned char)t[i]]++;
    }

    int left = 0, right = 0;
    int formed = 0; // Tracks how many unique characters meet the required count

    // Track the smallest valid window details
    int min_len = INT_MAX;
    int start_idx = 0;

    while (right < s_len) {
        char c = s[right];
        map_window[(unsigned char)c]++;

        // If the current character's frequency matches its required frequency in t
        if (map_t[(unsigned char)c] > 0 && map_window[(unsigned char)c] == map_t[(unsigned char)c]) {
            formed++;
        }

        // Try to contract the window from the left once a valid window is found
        while (left <= right && formed == required_unique) {
            c = s[left];

            // Save the smallest window details
            if (right - left + 1 < min_len) {
                min_len = right - left + 1;
                start_idx = left;
            }

            // Remove the character at the left pointer from the window
            map_window[(unsigned char)c]--;
            if (map_t[(unsigned char)c] > 0 && map_window[(unsigned char)c] < map_t[(unsigned char)c]) {
                formed--;
            }

            left++;
        }

        right++;
    }

    // If no valid window was found, return an empty string
    if (min_len == INT_MAX) {
        return "";
    }

    // Allocate memory for the result substring
    char* result = (char*)malloc((min_len + 1) * sizeof(char));
    strncpy(result, s + start_idx, min_len);
    result[min_len] = '\0';

    return result;
}
