int mySqrt(int x) {
    if (x == 0 || x == 1) {
        return x;
    }
    
    int low = 1;
    int high = x;
    int ans = 0;
    
    while (low <= high) {
        int mid = low + (high - low) / 2;
        
        // Use division to prevent integer overflow
        if (mid <= x / mid) {
            ans = mid;     // Keep track of the potential answer
            low = mid + 1; // Try to find a larger value
        } else {
            high = mid - 1; // Try smaller values
        }
    }
    
    return ans;
}
