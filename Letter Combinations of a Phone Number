#include <stdlib.h>
#include <string.h>

// Global keypad map matching phone digits 0-9 to their letters
const char* PHONE_MAP[] = {
    "",     // 0
    "",     // 1
    "abc",  // 2
    "def",  // 3
    "ghi",  // 4
    "jkl",  // 5
    "mno",  // 6
    "pqrs", // 7
    "tuv",  // 8
    "wxyz"  // 9
};

void backtrack(char* digits, int index, char* current, char** result, int* returnSize) {
    // Base Case: If the combination is complete, save it to the result array
    if (digits[index] == '\0') {
        result[*returnSize] = strdup(current);
        (*returnSize)++;
        return;
    }
    
    int digit = digits[index] - '0';
    const char* letters = PHONE_MAP[digit];
    
    // Recurse through all letters mapped to the current digit
    for (int i = 0; letters[i] != '\0'; i++) {
        current[index] = letters[i];
        current[index + 1] = '\0'; // Ensure string is null-terminated
        backtrack(digits, index + 1, current, result, returnSize);
    }
}

char** letterCombinations(char* digits, int* returnSize) {
    *returnSize = 0;
    int len = strlen(digits);
    
    if (len == 0) {
        return NULL;
    }
    
    // Calculate total possible combinations (max 4^4 = 256)
    int maxCombinations = 1;
    for (int i = 0; i < len; i++) {
        int digit = digits[i] - '0';
        maxCombinations *= (digit == 7 || digit == 9) ? 4 : 3;
    }
    
    // Allocate memory for the list of result strings
    char** result = (char**)malloc(sizeof(char*) * maxCombinations);
    
    // Buffer to construct current combination dynamically
    char* current = (char*)malloc(sizeof(char) * (len + 1));
    current[0] = '\0';
    
    backtrack(digits, 0, current, result, returnSize);
    
    free(current);
    return result;
}
