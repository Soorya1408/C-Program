#include <stdbool.h>
#include <stdlib.h>
#include <math.h>

#define HASH_SIZE 200003 // A prime number larger than max expected window size

typedef struct HashNode {
    long long bucketId;
    long long value;
    bool isOccupied;
} HashNode;

// Helper function to map a value to its correct bucket ID
long long getBucketId(long long val, long long w) {
    return val >= 0 ? val / w : (val + 1) / w - 1;
}

// Simple Open Addressing Hash Table Functions
int hashFunction(long long bucketId) {
    long long hash = bucketId % HASH_SIZE;
    if (hash < 0) hash += HASH_SIZE;
    return (int)hash;
}

void insert(HashNode* hashTable, long long bucketId, long long value) {
    int idx = hashFunction(bucketId);
    while (hashTable[idx].isOccupied) {
        idx = (idx + 1) % HASH_SIZE;
    }
    hashTable[idx].bucketId = bucketId;
    hashTable[idx].value = value;
    hashTable[idx].isOccupied = true;
}

bool search(HashNode* hashTable, long long bucketId, long long* foundValue) {
    int idx = hashFunction(bucketId);
    while (hashTable[idx].isOccupied) {
        if (hashTable[idx].bucketId == bucketId) {
            *foundValue = hashTable[idx].value;
            return true;
        }
        idx = (idx + 1) % HASH_SIZE;
    }
    return false;
}

void removeBucket(HashNode* hashTable, long long bucketId) {
    int idx = hashFunction(bucketId);
    while (hashTable[idx].isOccupied) {
        if (hashTable[idx].bucketId == bucketId) {
            hashTable[idx].isOccupied = false;
            // Rehash elements in the cluster to keep linear probing valid
            int nextIdx = (idx + 1) % HASH_SIZE;
            while (hashTable[nextIdx].isOccupied) {
                HashNode temp = hashTable[nextIdx];
                hashTable[nextIdx].isOccupied = false;
                insert(hashTable, temp.bucketId, temp.value);
                nextIdx = (nextIdx + 1) % HASH_SIZE;
            }
            return;
        }
        idx = (idx + 1) % HASH_SIZE;
    }
}

bool containsNearbyAlmostDuplicate(int* nums, int numsSize, int indexDiff, int valueDiff) {
    if (numsSize < 2 || indexDiff < 1 || valueDiff < 0) return false;

    // Allocate and initialize hash table
    HashNode* hashTable = (HashNode*)calloc(HASH_SIZE, sizeof(HashNode));
    long long w = (long long)valueDiff + 1;

    for (int i = 0; i < numsSize; i++) {
        long long val = nums[i];
        long long bucketId = getBucketId(val, w);
        long long foundValue;

        // 1. Check current bucket
        if (search(hashTable, bucketId, &foundValue)) {
            free(hashTable);
            return true;
        }
        // 2. Check left adjacent bucket
        if (search(hashTable, bucketId - 1, &foundValue) && labs(val - foundValue) <= valueDiff) {
            free(hashTable);
            return true;
        }
        // 3. Check right adjacent bucket
        if (search(hashTable, bucketId + 1, &foundValue) && labs(val - foundValue) <= valueDiff) {
            free(hashTable);
            return true;
        }

        // Add current element to the hash table
        insert(hashTable, bucketId, val);

        // Maintain sliding window size of indexDiff
        if (i >= indexDiff) {
            long long oldBucketId = getBucketId(nums[i - indexDiff], w);
            removeBucket(hashTable, oldBucketId);
        }
    }

    free(hashTable);
    return false;
}
